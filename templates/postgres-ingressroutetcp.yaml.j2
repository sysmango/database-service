apiVersion: traefik.io/v1alpha1
kind: IngressRouteTCP
metadata:
  name: postgres-tcp
  namespace: {{ db_namespace }}
spec:
  entryPoints:
    - {{ traefik_entrypoint_name }}
  tls:
    passthrough: true
  routes:
    - match: "HostSNI(`{{ pg_hostname }}`)"
      services:
        - name: postgresql
          port: 5432
